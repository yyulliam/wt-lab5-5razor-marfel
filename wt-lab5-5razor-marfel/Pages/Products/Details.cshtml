@page
@model wt_lab5_5razor_marfel.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Детали задачи";
}

<div class="container py-4">
    <h1>Детали задачи</h1>
    <div class="card shadow-sm rounded-4 mt-4" style="max-width: 600px;">
        <div class="card-body">
            <h3 class="card-title">@Model.Task.Title</h3>
            <hr />
            <p><strong>ID:</strong> @Model.Task.Id</p>
            <p><strong>Исполнитель:</strong> @Model.Task.Assignee</p>
            <p><strong>Приоритет:</strong> @Model.Task.Priority</p>
            <p><strong>Статус:</strong> @(Model.Task.IsCompleted ? "Выполнена" : "В работе")</p>
            <a asp-page="./Index" class="btn btn-secondary mt-3">Назад к списку</a>
        </div>
    </div>
</div>