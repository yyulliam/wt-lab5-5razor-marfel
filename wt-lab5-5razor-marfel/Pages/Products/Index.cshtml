@page
@model wt_lab5_5razor_marfel.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Задачи";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Задачи IT-проекта</h1>
            <p class="text-muted">Список текущих задач</p>
        </div>
        <a asp-page="/Products/Create" class="btn btn-primary">Добавить задачу</a>
    </div>

    <div class="row g-4">
        @foreach (var task in Model.Tasks)
        {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4">
                        <div class="card-body">
                            <span class="badge bg-secondary mb-2">ID: @task.Id</span>
                            <h5 class="card-title">@task.Title</h5>
                            <p class="text-muted">Исполнитель: @task.Assignee</p>
                            <p class="fs-5 fw-bold">Приоритет: @task.Priority</p>
                        @if (task.IsCompleted)
                        {
                                    <span class="badge bg-success">Выполнена</span>
                        }
                        else
                        {
                                    <span class="badge bg-warning text-dark">В работе</span>
                        }
                            <div class="mt-3">
                                <a asp-page="/Products/Details" asp-route-id="@task.Id" class="btn btn-outline-primary btn-sm">Детали</a>
                                <a asp-page="/Products/Edit" asp-route-id="@task.Id" class="btn btn-outline-secondary btn-sm">Редактировать</a>
                            </div>
                        </div>
                    </div>
                </div>
        }
    </div>
</div>