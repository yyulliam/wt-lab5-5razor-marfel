@page
@model wt_lab5_5razor_marfel.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Добавить задачу";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="mb-4">Добавление задачи</h2>
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Task.Title" class="form-label">Название</label>
                            <input asp-for="Task.Title" class="form-control" />
                            <span asp-validation-for="Task.Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Task.Assignee" class="form-label">Исполнитель</label>
                            <input asp-for="Task.Assignee" class="form-control" />
                            <span asp-validation-for="Task.Assignee" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Task.Priority" class="form-label">Приоритет</label>
                            <input asp-for="Task.Priority" class="form-control" />
                        </div>
                        <div class="form-check mb-4">
                            <input asp-for="Task.IsCompleted" class="form-check-input" />
                            <label asp-for="Task.IsCompleted" class="form-check-label">Выполнена</label>
                        </div>
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a asp-page="./Index" class="btn btn-secondary">Назад</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>